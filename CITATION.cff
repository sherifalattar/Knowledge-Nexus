    given-names: "Sherif"
    orcid: "https://orcid.org/0009-0000-8799-9395"
url: "https://sherifalattar.github.io/Knowledge-Nexus"
repository-code: "https://github.com/sherifalattar/Knowledge-Nexus"
keywords: [DRG validation, IR-DRG, clinical validation, denial management, utilization management]
